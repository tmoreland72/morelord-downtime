<section class="ml-app ml-app-shell ml-stack" data-gap="3">
  <header class="ml-hero">
    <i class="fa-solid fa-folder-open ml-hero__icon"></i>
    <div class="ml-hero__body"><p class="ml-eyebrow">{{project.activityLabel}} · {{project.status}}</p><h1>{{project.name}}</h1></div>
  </header>
  <section class="ml-surface ml-stack" data-gap="2">
    <h2>Project Details</h2>
    <dl class="ml-data-list">
      <div><dt>Owner</dt><dd>{{project.ownerName}}</dd></div>
      <div><dt>Participants</dt><dd>{{project.participantSummary}}</dd></div>
      <div><dt>Location</dt><dd>{{project.locationName}}</dd></div>
      {{#if project.instructorName}}<div><dt>Instructor</dt><dd>{{project.instructorName}}</dd></div>{{/if}}
      {{#if project.usesEffort}}<div><dt>Effort</dt><dd>{{project.effortLabel}}</dd></div>{{/if}}
      {{#if project.usesElapsed}}<div><dt>Elapsed Time</dt><dd>{{project.elapsedLabel}}</dd></div>{{/if}}
    </dl>
    {{#if project.commission}}<dl class="ml-data-list"><div><dt>Contractor</dt><dd>{{project.commission.contractorName}}</dd></div><div><dt>Item</dt><dd>{{project.commission.itemDescription}}</dd></div>{{#if project.commission.notes}}<div><dt>Notes</dt><dd>{{project.commission.notes}}</dd></div>{{/if}}</dl>{{#if project.commission.canCollect}}<div class="ml-actions"><button type="button" data-action="collectCommission"><i class="fa-solid fa-box-open"></i> Collect Commission</button></div>{{/if}}{{/if}}
    {{#if project.sourceItem}}<dl class="ml-data-list"><div><dt>Wanted Item</dt><dd>{{project.sourceItem.target.name}} ({{project.sourceItem.target.rarityLabel}})</dd></div><div><dt>Check</dt><dd>{{project.sourceItem.checkLabel}} vs. DC {{project.sourceItem.dc}}</dd></div><div><dt>Investment</dt><dd>{{project.sourceItem.investmentGp}} gp and {{project.sourceItem.weeks}} week(s), +{{project.sourceItem.bonus}}</dd></div></dl>{{/if}}
  </section>
  {{#if project.sourceItem.outcome}}<section class="ml-surface ml-stack" data-gap="3"><div class="ml-section-heading"><div><h2>Sourcing Result</h2><p>The hidden check has been resolved.</p></div><span class="ml-badge" data-tone="{{#if project.sourceItem.outcome.success}}success{{else}}warning{{/if}}">{{#if project.sourceItem.outcome.success}}Item Found{{else}}Not Found{{/if}}</span></div><dl class="ml-data-list"><div><dt>Check Total</dt><dd>{{project.sourceItem.outcome.checkTotal}} check + {{project.sourceItem.outcome.investmentBonus}} investment = {{project.sourceItem.outcome.total}}</dd></div>{{#if project.sourceItem.targetPriceLabel}}<div><dt>Offer Price</dt><dd>{{project.sourceItem.targetPriceLabel}}</dd></div>{{/if}}{{#if project.sourceItem.persuasionLabel}}<div><dt>Persuasion</dt><dd>{{project.sourceItem.persuasionLabel}}</dd></div>{{/if}}</dl><div class="ml-grid" data-columns="auto">{{#if project.sourceItem.outcome.success}}<article class="ml-card ml-source-item-offer"><img src="{{project.sourceItem.target.img}}" alt="{{project.sourceItem.target.name}}"><div><button type="button" class="ml-link-button" data-action="openSourceItem" data-uuid="{{project.sourceItem.target.uuid}}">{{project.sourceItem.target.name}}</button><span>{{project.sourceItem.target.rarityLabel}}</span><span>{{project.sourceItem.targetPriceLabel}}</span></div></article>{{else}}{{#each project.sourceItem.alternatives}}<article class="ml-card ml-source-item-offer"><img src="{{img}}" alt="{{name}}"><div><button type="button" class="ml-link-button" data-action="openSourceItem" data-uuid="{{uuid}}">{{name}}</button><span>{{rarityLabel}}</span><span>{{priceLabel}}</span></div></article>{{else}}<p class="ml-empty-message">No eligible alternative items were available.</p>{{/each}}{{/if}}</div>{{#if project.sourceItem.canNegotiate}}<div class="ml-actions"><button type="button" data-action="negotiateSourceItem"><i class="fa-solid fa-comments-dollar"></i> Attempt Persuasion</button></div>{{/if}}</section>{{/if}}
  {{#if project.metadata.research}}<section class="ml-surface ml-stack" data-gap="2">
    <h2>Recipe Research</h2>
    <div class="ml-item-row"><img src="{{project.metadata.research.component.img}}" alt=""><div class="ml-stack"><strong>{{project.metadata.research.component.name}}</strong><span>{{project.metadata.research.component.inventoryName}}</span></div></div>
    {{#if project.metadata.research.outcome}}
      <p>Recipes found for this component family and rarity:</p>
      {{#each project.metadata.research.outcome.recipes}}<button type="button" class="ml-card ml-item-row" data-action="openResearchRecipe" data-recipe-id="{{id}}"><img src="{{img}}" alt=""><span class="ml-stack"><strong>{{name}}</strong><span>View Recipe</span></span></button>
      {{else}}<p class="ml-empty-message">No matching recipes were found in the enabled Drakkenheim catalog.</p>{{/each}}
    {{else}}<p class="notes">Allocate one hour to reveal up to five random recipes. The component is not consumed.</p>{{/if}}
  </section>{{/if}}
  {{#if project.canPlan}}<section class="ml-surface"><button type="button" data-action="planProject" data-session-id="{{project.plannedSessionId}}"><i class="fa-solid fa-calendar-plus"></i> Plan for Upcoming Session</button></section>{{/if}}
  {{#if project.canAllocate}}<section class="ml-surface ml-stack" data-gap="2"><h2>Allocate Time</h2><div class="ml-downtime-allocation"><fieldset class="ml-field-group"><legend>Contributors</legend><div class="ml-check-grid">{{#each project.allocationParticipants}}<label class="ml-check"><input type="checkbox" data-allocation-actor value="{{actorUuid}}" {{#if checked}}checked{{/if}} {{#unless remainingHours}}disabled{{/unless}}><span>{{name}} ({{remainingHours}}h)</span></label>{{/each}}</div></fieldset><label><span>Hours</span><input type="number" data-allocation-hours min="0.5" step="0.5" value="1"></label><button type="button" data-action="allocate" data-allocation-pool-id="{{project.allocationPoolId}}">Allocate</button></div></section>{{/if}}
  <section class="ml-surface ml-stack" data-gap="2">
    <div class="ml-section-heading"><div><h2>Project History</h2><p>Progress, decisions, and status changes recorded for this Project.</p></div></div>
    <ol class="ml-stack" data-gap="2">{{#each project.history}}<li class="ml-card ml-stack" data-gap="1"><strong>{{label}}</strong><small>{{when}}</small>{{#if details}}<p>{{details}}</p>{{/if}}</li>{{/each}}</ol>
  </section>
  <footer class="ml-page-footer ml-actions">{{#if canCancelProject}}<button type="button" data-action="cancelProject" data-tone="danger"><i class="fa-solid fa-ban"></i> Cancel Project</button>{{/if}}{{#if canDeleteProject}}<button type="button" data-action="deleteProject" data-tone="danger"><i class="fa-solid fa-trash"></i> Delete Project</button>{{/if}}</footer>
</section>
