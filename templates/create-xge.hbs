<section class="ml-app ml-app-shell">
  <header class="ml-hero"><i class="fa-solid fa-hourglass ml-hero__icon"></i><div class="ml-hero__body"><h1>{{activityName}}</h1><p>This activity takes 7 days.{{#if needsTemple}} The Location needs a Temple.{{/if}}{{#if needsLibrary}} The Location needs a Library.{{/if}}</p></div></header>
  <div class="ml-grid" data-columns="2">
    <label><span>Character</span><select name="ownerUuid" required><option value="">Choose a character</option>{{#each owners}}<option value="{{uuid}}">{{name}}</option>{{/each}}</select></label>
    <label><span>Location</span><select name="locationId" required><option value="">Choose a Location</option>{{#each locations}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    {{#if isReligious}}<label><span>Check</span><select name="skill" data-check-options>{{#each religiousChecks}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label>{{/if}}
    {{#if isCarousing}}<label><span>Social Class</span><select name="socialClass"><option value="lower">Lower class, 10 gp</option><option value="middle">Middle class, 50 gp</option><option value="upper">Upper class, 250 gp</option></select></label><label><span>People</span><input name="npcNames" type="text" placeholder="Who are you with?"></label>{{#if isGm}}<label class="ml-check"><input type="checkbox" name="nobilityAccess"><span>GM confirms access to the local nobility</span></label>{{/if}}{{/if}}
    {{#if isCrime}}<label><span>Difficulty</span><select name="crimeDc"><option value="10">DC 10, 50 gp</option><option value="15">DC 15, 100 gp</option><option value="20">DC 20, 200 gp</option><option value="25">DC 25, 1,000 gp</option></select></label><label><span>Third Check</span><select name="thirdSkill" data-check-options>{{#each crimeChecks}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label><label><span>The Job</span><input name="crimeNotes" type="text" placeholder="What is the crime?"></label>{{/if}}
    {{#if isGambling}}<label><span>Stake (gp)</span><input name="stakeGp" type="number" min="10" step="1" value="10"></label><label><span>Replace One Check</span><select name="gamingSet" data-check-options><option value="">No gaming set</option>{{#each gamblingTools}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label><label><span>Which Check</span><select name="replaceIndex" data-check-options>{{#each gamblingChecks}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label>{{#if isGm}}<label class="ml-check"><input type="checkbox" name="allowHighStake"><span>GM allows a stake above 1,000 gp</span></label>{{/if}}{{/if}}
    {{#if isPit}}<label><span>Replace One Check With an Attack</span><select name="replaceWithAttack" data-check-options><option value="">No</option>{{#each pitChecks}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label>{{/if}}
    {{#if isResearch}}<label><span>Check</span><select name="skill" data-check-options>{{#each researchChecks}}<option value="{{value}}" data-check-kind="{{kind}}" data-check-id="{{id}}" data-check-label="{{name}}">{{label}}</option>{{/each}}</select></label><label><span>Extra Gold (gp)</span><input name="extraGp" type="number" min="0" max="600" step="100" value="0"></label><label><span>Question</span><input name="question" type="text" placeholder="What are you trying to learn?"></label>{{/if}}
  </div>
  <div class="ml-actions"><button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Start {{activityName}}</button></div>
</section>
