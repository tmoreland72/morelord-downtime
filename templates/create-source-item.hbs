<section class="ml-app ml-app-shell">
  <header class="ml-hero"><i class="fa-solid fa-magnifying-glass-dollar ml-hero__icon"></i><div class="ml-hero__body"><h1>{{#if isEditing}}Edit{{else}}New{{/if}} Source Item Project</h1><p>Spend gold and weeks searching for a magic item from the character's Marketplace wishlist.</p></div></header>
  {{#if resolved}}<aside class="ml-callout" data-tone="warning"><i class="fa-solid fa-lock"></i><div><strong>Search resolved</strong><p>A revealed sourcing result can no longer be edited.</p></div></aside>{{/if}}
  <div class="ml-grid" data-columns="2">
    <label><span>Owner</span>{{#if isEditing}}<input type="hidden" name="ownerUuid" value="{{ownerUuid}}">{{/if}}<select name="ownerUuid" {{#if isEditing}}disabled{{/if}}><option value="">Choose a character</option>{{#each owners}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label><span>Location</span><select name="locationId" {{#if resolved}}disabled{{/if}}><option value="">Choose a Location</option>{{#each locations}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label><span>Wishlist Item</span>{{#if isEditing}}<input type="hidden" name="targetUuid" value="{{targetUuid}}">{{/if}}<select name="targetUuid" {{#unless hasWishlist}}disabled{{/unless}} {{#if isEditing}}disabled{{/if}}><option value="">Choose a magic item</option>{{#each wishlist}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} — {{rarityLabel}}</option>{{/each}}</select></label>
    <label><span>Sourcing Check</span><select name="checkSkill" {{#if resolved}}disabled{{/if}}><option value="arc" {{#if checkArcana}}selected{{/if}}>Arcana ({{arcanaModifier}})</option><option value="inv" {{#if checkInvestigation}}selected{{/if}}>Investigation ({{investigationModifier}})</option></select></label>
    <label><span class="ml-field-label">Investment (gp)<button type="button" class="ml-help-button" aria-label="About sourcing investment" data-tooltip="The minimum is 100 gp. Add or remove 250 gp at a time; each additional 250 gp grants +2. This vendor and contractor fee is non-refundable even if the item is not found."><i class="fa-regular fa-circle-question"></i></button></span><span class="ml-stepper"><button type="button" data-step-target="investmentGp" data-step="-250" aria-label="Remove 250 gp" {{#if resolved}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button><input name="investmentGp" type="number" min="{{investmentGp}}" step="250" value="{{investmentGp}}" readonly><button type="button" data-step-target="investmentGp" data-step="250" data-maximum="{{maxInvestmentGp}}" aria-label="Add 250 gp" {{#if resolved}}disabled{{/if}}><i class="fa-solid fa-plus"></i></button></span><small>{{availableGp}} gp currently available</small></label>
    <label><span class="ml-field-label">Search Time (weeks)<button type="button" class="ml-help-button" aria-label="About search time" data-tooltip="The minimum is one week. Add or remove one week at a time; each additional week grants +2. Progress advances with elapsed campaign days."><i class="fa-regular fa-circle-question"></i></button></span><span class="ml-stepper"><button type="button" data-step-target="weeks" data-step="-1" aria-label="Remove one week" {{#if resolved}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button><input name="weeks" type="number" min="{{weeks}}" step="1" value="{{weeks}}" readonly><button type="button" data-step-target="weeks" data-step="1" aria-label="Add one week" {{#if resolved}}disabled{{/if}}><i class="fa-solid fa-plus"></i></button></span></label>
  </div>
  {{#unless hasWishlist}}<aside class="ml-callout" data-tone="warning"><i class="fa-regular fa-heart"></i><div><strong>No available wishlist items</strong><p>Add a Common through Legendary magic item to this character's Marketplace wishlist, then return here.</p></div></aside>{{/unless}}
  <section class="ml-surface ml-cluster ml-source-item-summary"><div><span class="ml-eyebrow">Investment Bonus</span><strong data-sourcing-bonus>+{{bonus}}</strong></div><p>The selected skill check is rolled automatically and remains hidden until the final day. Guidance and Help do not apply.</p></section>
  <footer class="ml-page-footer ml-actions">{{#if canCancelProject}}<button type="button" data-action="cancelProject" data-tone="danger"><i class="fa-solid fa-ban"></i> Cancel Project</button>{{/if}}{{#if canDeleteProject}}<button type="button" data-action="deleteProject" data-tone="danger"><i class="fa-solid fa-trash"></i> Delete Project</button>{{/if}}{{#unless resolved}}<button type="button" data-action="save" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{#if isEditing}}Save Search{{else}}Begin Search{{/if}}</button>{{/unless}}</footer>
</section>
