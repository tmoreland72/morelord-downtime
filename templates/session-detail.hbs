<section class="ml-app ml-stack" data-gap="3">
  <header class="ml-hero">
    <i class="fa-solid fa-calendar-days ml-hero__icon"></i>
    <div class="ml-hero__body"><span class="ml-badge">{{session.statusLabel}}</span><h1>{{session.name}}</h1><p>{{session.description}}</p></div>
  </header>
  <section class="ml-surface ml-stack" data-gap="2">
    <h2>Session Details</h2>
    <dl class="ml-data-list">
      <div><dt>Location</dt><dd>{{session.locationName}}</dd></div>
      <div><dt>Days</dt><dd>{{session.daysLabel}}</dd></div>
      <div><dt>Hours</dt><dd>{{session.plannedDurationHours}} hours per character</dd></div>
      <div><dt>Participants</dt><dd>{{session.participantSummary}}</dd></div>
      <div><dt>Available Project Types</dt><dd>{{session.activitySummary}}</dd></div>
    </dl>
    {{#if session.gmNotes}}<aside class="ml-callout" data-tone="info"><i class="fa-solid fa-note-sticky"></i><div><strong>GM Notes</strong><p>{{session.gmNotes}}</p></div></aside>{{/if}}
  </section>
  <section class="ml-surface ml-stack" data-gap="2">
    <div class="ml-section-heading"><div><h2>Participant Time</h2><p>Time each character has spent in this Session.</p></div></div>
    {{#if session.hasParticipantTime}}<dl class="ml-data-list">{{#each session.participantTime}}<div><dt>{{name}}</dt><dd>{{timeLabel}}</dd></div>{{/each}}</dl>{{else}}<p>This Session has no participants.</p>{{/if}}
  </section>
  <section class="ml-surface ml-stack" data-gap="2">
    <div class="ml-section-heading"><div><h2>Projects</h2><p>Work underway for the characters in this Session.</p></div></div>
    {{#if session.hasProjects}}<div class="ml-downtime-session-projects">{{#each session.projects}}<div data-project-id="{{id}}">{{#if presenceTracked}}{{#if canTogglePresence}}<button type="button" class="ml-presence-dot" data-presence="{{presenceState}}" data-action="setPresenceFocus" data-tooltip="{{presenceTooltip}}" aria-label="{{presenceTooltip}}"></button>{{else}}<span class="ml-presence-dot" data-presence="{{presenceState}}" data-tooltip="{{presenceTooltip}}" aria-label="{{presenceTooltip}}"></span>{{/if}}{{/if}}<button type="button" class="ml-link-button" data-action="viewProject">{{name}}</button><span>{{ownerName}} · {{activityLabel}}</span>{{#if canTogglePresence}}<button type="button" class="ml-downtime-make-active" data-action="setPresenceFocus">Make Active</button>{{/if}}</div>{{/each}}</div>{{else}}<p>No projects are underway for these characters.</p>{{/if}}
  </section>
  <section class="ml-surface ml-stack" data-gap="2">
    <div class="ml-section-heading"><div><h2>Session History</h2><p>Every change and result recorded while this Session was open, oldest first.</p></div></div>
    {{#if session.hasHistory}}<dl class="ml-data-list">{{#each session.historyEntries}}<div><dt>{{who}}</dt><dd>{{project}}: {{change}}{{#if result}}. {{result}}{{/if}} · {{when}}</dd></div>{{/each}}</dl>{{else}}<p>Nothing has been recorded for this Session.</p>{{/if}}
  </section>
</section>
